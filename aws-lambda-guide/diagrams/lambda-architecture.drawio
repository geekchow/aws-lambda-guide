<mxfile host="app.diagrams.net">
  <diagram id="lambda-arch" name="Lambda control + data plane">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="AWS Lambda: how ShopFast checkout:prod is deployed, pre-warmed and invoked" style="text;html=1;fontSize=20;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1200" height="40" as="geometry" />
        </mxCell>

        <!-- Lanes -->
        <mxCell id="laneCaller" value="Callers" style="swimlane;horizontal=0;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="1520" height="150" as="geometry" />
        </mxCell>
        <mxCell id="laneCP" value="Control plane (you configure)" style="swimlane;horizontal=0;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="220" width="1520" height="200" as="geometry" />
        </mxCell>
        <mxCell id="laneDP" value="Data plane (per invocation)" style="swimlane;horizontal=0;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="1520" height="220" as="geometry" />
        </mxCell>
        <mxCell id="laneWorkers" value="Worker fleet (EC2 bare-metal, Firecracker microVMs)" style="swimlane;horizontal=0;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="660" width="1520" height="300" as="geometry" />
        </mxCell>

        <!-- Callers lane -->
        <mxCell id="ci" value="CI/CD pipeline&lt;br&gt;update code, publish-version" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneCaller">
          <mxGeometry x="70" y="45" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cd" value="CodeDeploy&lt;br&gt;Canary10Percent10Minutes" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneCaller">
          <mxGeometry x="310" y="45" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="aas" value="Application Auto Scaling&lt;br&gt;08:30 min=400; target 0.7" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneCaller">
          <mxGeometry x="550" y="45" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="apigw" value="API Gateway&lt;br&gt;integration: checkout:prod" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="laneCaller">
          <mxGeometry x="1000" y="45" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="users" value="Shoppers&lt;br&gt;Alice, Bob, Carol" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="laneCaller">
          <mxGeometry x="1290" y="40" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Control plane lane -->
        <mxCell id="latest" value="$LATEST&lt;br&gt;(mutable draft)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="laneCP">
          <mxGeometry x="70" y="40" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v7" value="Version 7&lt;br&gt;immutable" style="shape=cylinder3;whiteSpace=wrap;html=1;size=8;" vertex="1" parent="laneCP">
          <mxGeometry x="70" y="120" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v8" value="Version 8&lt;br&gt;zip + Node 22, 1024 MB, 10 s" style="shape=cylinder3;whiteSpace=wrap;html=1;size=8;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="laneCP">
          <mxGeometry x="270" y="110" width="200" height="70" as="geometry" />
        </mxCell>
        <mxCell id="alias" value="Alias prod&lt;br&gt;Thu: 7=0.9 / 8=0.1&lt;br&gt;then 8=1.0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="laneCP">
          <mxGeometry x="560" y="60" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pcm" value="PC config on prod&lt;br&gt;50 → 400 (READY)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="laneCP">
          <mxGeometry x="830" y="60" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rc" value="Reserved concurrency&lt;br&gt;checkout = 800&lt;br&gt;(account quota 3,000)" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="laneCP">
          <mxGeometry x="1100" y="60" width="200" height="80" as="geometry" />
        </mxCell>

        <!-- Data plane lane -->
        <mxCell id="fe" value="Invoke Frontend&lt;br&gt;AuthN/AuthZ, resolve prod → v8" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneDP">
          <mxGeometry x="1000" y="40" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cs" value="Counting service&lt;br&gt;675/800 ok; 801st → 429" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneDP">
          <mxGeometry x="1270" y="40" width="210" height="70" as="geometry" />
        </mxCell>
        <mxCell id="as" value="Assignment service&lt;br&gt;env states: idle / busy / init" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneDP">
          <mxGeometry x="700" y="130" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl" value="Placement service&lt;br&gt;pick worker, spread AZs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="laneDP">
          <mxGeometry x="330" y="130" width="220" height="70" as="geometry" />
        </mxCell>

        <!-- Worker lane -->
        <mxCell id="pcpool" value="Provisioned pool: 400 × v8 envs&lt;br&gt;Init ran at 08:30&lt;br&gt;(Alice, the 09:00 wave)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="laneWorkers">
          <mxGeometry x="640" y="50" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="odpool" value="On-demand v8 envs (spillover)&lt;br&gt;boot + Init 600 ms in-request&lt;br&gt;(Bob)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneWorkers">
          <mxGeometry x="280" y="50" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="envdetail" value="Each env = Firecracker microVM: guest kernel + Node 22 runtime + extensions + handler.js&lt;br&gt;One request at a time · frozen between invokes · Runtime API /invocation/next" style="text;html=1;whiteSpace=wrap;align=left;fontSize=12;" vertex="1" parent="laneWorkers">
          <mxGeometry x="280" y="170" width="700" height="50" as="geometry" />
        </mxCell>
        <mxCell id="throttle" value="429 TooManyRequests&lt;br&gt;(Carol) — no env touched" style="shape=hexagon;perimeter=hexagonPerimeter2;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="laneWorkers">
          <mxGeometry x="1270" y="50" width="210" height="80" as="geometry" />
        </mxCell>

        <!-- Edges: deploy path -->
        <mxCell id="e1" value="1 update code" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="ci" target="latest"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="2 publish-version" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="latest" target="v8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="3 weights" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="cd" target="alias"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="points to" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="alias" target="v8"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4b" value="(canary 0.9)" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="alias" target="v7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="set N" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="aas" target="pcm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="pre-create N" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="pcm" target="pl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="boot + Init early" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="pl" target="pcpool"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Edges: invoke path -->
        <mxCell id="i1" value="POST /checkout" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="users" target="apigw"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i2" value="Invoke checkout:prod" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="apigw" target="fe"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i3" value="acquire unit" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="fe" target="cs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i3b" value="limit" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="rc" target="cs"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i3c" value="denied" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="cs" target="throttle"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i4" value="acquire env v8" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="fe" target="as"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i5" value="lease warm env" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#d79b00;strokeWidth=2;" edge="1" parent="1" source="as" target="pcpool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i6" value="none idle: create" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="as" target="pl"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i7" value="cold start" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="pl" target="odpool"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="a1" value="artifact" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" edge="1" parent="1" source="v8" target="odpool"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="Legend: orange = request path · red = spillover / throttle · dashed = configuration reference · purple = versioned control-plane objects" style="text;html=1;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="965" width="1200" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
